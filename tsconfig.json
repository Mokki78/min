{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "src/app/priser",
    "src/app/tjenester/baby.tsx",
    "src/app/tjenester/familie.tsx",
    "src/app/tjenester/portrett.tsx",
    "src/app/tjenester/baby/page",
    "src/app/tjenester/portrett/page.tsx",
    "src/app/komponenter/GalleryBaby.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
